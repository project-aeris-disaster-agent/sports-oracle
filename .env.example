# .env.local
# Copy to .env.local — never commit this file.
# All vars prefixed NEXT_PUBLIC_ are safe to expose to the browser.
# Everything else is server-only.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose client-side

# ── Sportradar ────────────────────────────────────────────────────────────────
SPORTRADAR_API_KEY=your-sportradar-key             # Server-only

# ── Esports ───────────────────────────────────────────────────────────────────
# OpenDota (Dota 2). OPTIONAL — the public tier works without a key; supplying one
# raises the limits. Leave blank and no api_key param is sent at all.
OPENDOTA_API_KEY=

# Liquipedia. Required ONLY if the liquipedia provider is ever switched from
# offline to live. Their terms require an identifying User-Agent carrying a real
# contact address, so this has no safe default and the provider throws without it.
# Format: AppName/1.0 (https://yourdomain.com; contact@yourdomain.com)
LIQUIPEDIA_USER_AGENT=

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Privy (auth) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret             # Server-only

# ── Base / blockchain ─────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_CHAIN_ID=8453
STAKING_CONTRACT_ADDRESS=0x...your-contract-address
DARE_TOKEN_ADDRESS=0x...your-token-address
ALCHEMY_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-key

# The dashboard builds stake/unstake transactions in the browser, so it needs the
# same two addresses the server reads from. Leave these unset to use the deployed
# defaults baked into lib/staking.ts; if you DO set them, set them to the same
# values as above — a mismatch means users stake into a contract the gateway
# never checks, and their keys would never unlock.
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=
NEXT_PUBLIC_DARE_TOKEN_ADDRESS=

# ── Internal security ─────────────────────────────────────────────────────────
# Random secret shared between GitHub Actions and /api/internal/* routes
# Generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET=your-random-secret-here

# Signing key for the Alchemy webhook that drives /api/internal/stake-event.
# Without it, an unstake is only noticed by the scheduled watcher — up to ~30
# minutes of paid access outliving the stake that paid for it. With it, the
# window is seconds. Create a Custom Webhook on the staking contract's address
# pointing at <APP_URL>/api/internal/stake-event and paste its signing key here.
ALCHEMY_WEBHOOK_SIGNING_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000          # Change to prod URL in Vercel env vars
APP_URL=http://localhost:3000                      # Used by GitHub Actions — set in repo secrets
